# Local development (SQLite)
DATABASE_URI=file:./petster.db

# Production (Neon Postgres on Vercel)
# DATABASE_URI=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Neon/Vercel may provide DATABASE_URL instead. The app accepts either name.

PAYLOAD_SECRET=replace-with-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production admin (seeded on first deploy when DATABASE_URI is Postgres)
# PAYLOAD_ADMIN_EMAIL=admin@petster.local
# PAYLOAD_ADMIN_PASSWORD=change-me

# Auto-set when Vercel Blob is linked to the project
# BLOB_READ_WRITE_TOKEN=
