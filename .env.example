# Local development (SQLite)
DATABASE_URI=file:./goodpet.db

# Production (Neon Postgres on Vercel)
# DATABASE_URI=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Neon/Vercel may provide DATABASE_URL instead. The app accepts either name.

PAYLOAD_SECRET=replace-with-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production admin (seeded on first deploy when DATABASE_URI is Postgres)
# PAYLOAD_ADMIN_EMAIL=admin@goodpet.local
# PAYLOAD_ADMIN_PASSWORD=change-me

# Auto-set when Vercel Blob is linked to the project
# BLOB_READ_WRITE_TOKEN=

# Google Sheet -> Payload content sync (npm run sync:content)
# See docs/content-ops/sync-setup.md
# CONTENT_SHEET_ID=the-spreadsheet-id-from-its-url
# CONTENT_SHEET_RANGE=Sheet1
# GOOGLE_SERVICE_ACCOUNT_EMAIL=content-sync@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
