# Local development (SQLite)
DATABASE_URI=file:./petster.db

# Production (Neon Postgres on Vercel) — example:
# DATABASE_URI=postgresql://user:pass@host/db?sslmode=require

PAYLOAD_SECRET=replace-with-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional admin bootstrap (production seed)
# PAYLOAD_ADMIN_EMAIL=admin@petster.local
# PAYLOAD_ADMIN_PASSWORD=change-me

# Set automatically when Vercel Blob is enabled
# BLOB_READ_WRITE_TOKEN=
