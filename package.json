{
  "name": "goodpet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/cms",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace goodpet-web",
    "dev:cms": "npm run dev --workspace goodpet-cms",
    "build:web": "npm run build --workspace goodpet-web",
    "build:cms": "npm run build --workspace goodpet-cms",
    "seed": "npm run seed --workspace goodpet-cms",
    "sync:content": "npm run sync:content --workspace goodpet-cms",
    "generate:types": "npm run generate:types --workspace goodpet-cms",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "react-doctor": "^0.2.16"
  }
}
